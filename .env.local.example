NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build the "Sign In" link in interviewer invitation emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP — used to email interviewer invitations (login credentials) from Admin → Interviewers
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="TNV Leadership Selection <no-reply@example.com>"
